# Copia este archivo a .env.local y rellena los valores.
# Los encuentras en Supabase > Project Settings > API.

# URL pública del proyecto Supabase (segura de exponer en el navegador).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave pública "anon" (segura de exponer en el navegador; solo permite
# lo que las políticas de Row Level Security dejan hacer, en este caso
# únicamente leer).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...

# Clave "service_role": acceso total, SIN restricciones de RLS.
# NUNCA la pongas en código que se ejecute en el navegador ni la subas
# a git. Solo se usa en scripts/seed.mjs, en tu máquina o en un entorno
# de servidor seguro (por ejemplo como variable de entorno en una GitHub
# Action que haga el seed, nunca en el bundle de Next.js).
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...
